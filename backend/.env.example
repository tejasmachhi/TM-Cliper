PORT=8000
HOST=0.0.0.0
APP_ENV=production
CORS_ORIGINS=*
SECRET_KEY=tmcliper_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials for YouTube Account Integration
# Setup Guide:
# 1. Create a Google Cloud Project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3" in APIs & Services -> Library
# 3. Configure OAuth Consent Screen (User Type: External, Scopes: youtube.readonly, youtube.upload)
# 4. In Credentials, create "OAuth 2.0 Client ID" (Application type: Web application)
# 5. Add Authorized Redirect URI: http://127.0.0.1:8000/api/youtube/callback (and your production domain callback)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback
# Optional 32-byte url-safe base64 Fernet key. If blank, auto-generated and stored in storage/credentials/
GOOGLE_TOKEN_ENCRYPTION_KEY=
